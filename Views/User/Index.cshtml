@model List<sampleapp.Models.UserInfo>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User List</h2>
        <a asp-controller="User" asp-action="AddUser" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add User
        </a>
    </div>

    <p class="text-muted">Total Users: @Model?.Count()</p>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm rounded align-middle" id="UserDT">
                <thead class="table-dark">
                    <tr>
                        <th>Reg No</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-end" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@(user.Role == "STUDENT" ? user.RegNo : "—")</td>
                            <td>@user.UserName</td>
                            <td>@user.EmailId</td>
                            <td>
                                <span class="badge @(user.Role == "ADMIN" ? "bg-danger" : "bg-info text-dark")">
                                    @user.Role
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="UserEdit" asp-route-id="@user.UserId" class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this user?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No users found.</div>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            $('#UserDT').DataTable({
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                paging: true,
                searching: true,
                ordering: true,
                responsive: true
            });
        });
    </script>
}

