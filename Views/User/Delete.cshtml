@model sampleapp.Models.UserInfo

@{
    ViewData["Title"] = "Delete User";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow p-4" style="width: 400px;">
        <h4 class="mb-4 text-center text-danger">Confirm Delete</h4>

        <form asp-action="DeleteConfirm" asp-controller="User" method="post">
            <input asp-for="UserId" type="hidden" />

            <div class="form-group">
                <label asp-for="RegNo"></label>
                <input asp-for="RegNo" class="form-control" readonly />
            </div>


            <div class="mb-3">
                <label asp-for="UserName" class="form-label">User Name</label>
                <input asp-for="UserName" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="EmailId" class="form-label">Email Address</label>
                <input asp-for="EmailId" class="form-control" readonly />
            </div>

            <div class="alert alert-warning text-center">
                Are you sure you want to delete this user?
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" asp-controller="User" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
