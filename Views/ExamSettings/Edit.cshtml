@model sampleapp.Models.ExamSettingViewModel

@{
    ViewData["Title"] = "Edit Exam Setting";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="max-width: 900px; width: 100%;">
        <h4 class="text-center mb-4">Edit Exam Setting</h4>

        <style>
            label.form-label {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                font-weight: 600;
                font-size: 1rem;
                color: #2c3e50;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                margin-bottom: 0.3rem;
                display: inline-block;
            }
        </style>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SubjectId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <!-- ✅ Subject (readonly display + hidden value) -->
                    <div class="mb-3">
                        <label class="form-label">Subject</label>
                        <input class="form-control" value="@Model.Subjects.FirstOrDefault(s => s.Value == Model.SubjectId.ToString())?.Text" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxQuestions" class="form-label">Max Questions</label>
                        <input asp-for="MaxQuestions" class="form-control" type="number" id="@Html.IdFor(m => m.MaxQuestions)" />
                        <span asp-validation-for="MaxQuestions" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MarkPerQuestion" class="form-label">Marks Per Question</label>
                        <input asp-for="MarkPerQuestion" class="form-control" type="number" id="@Html.IdFor(m => m.MarkPerQuestion)" />
                        <span asp-validation-for="MarkPerQuestion" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="QualifyMark" class="form-label">Qualify Marks</label>
                        <input asp-for="QualifyMark" class="form-control" type="number" id="@Html.IdFor(m => m.QualifyMark)" />
                        <span asp-validation-for="QualifyMark" class="text-danger"></span>
                        <span id="qualifyMarkError" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DurationMinutes" class="form-label">Duration (Minutes)</label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TotalMarks" class="form-label">Total Marks</label>
                        <input asp-for="TotalMarks" class="form-control" type="number" readonly id="@Html.IdFor(m => m.TotalMarks)" />
                        <span asp-validation-for="TotalMarks" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary me-2">Update Exam Setting</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");

            const maxQ = document.getElementById("@Html.IdFor(m => m.MaxQuestions)");
            const perMark = document.getElementById("@Html.IdFor(m => m.MarkPerQuestion)");
            const totalMarks = document.getElementById("@Html.IdFor(m => m.TotalMarks)");
            const qualify = document.getElementById("@Html.IdFor(m => m.QualifyMark)");
            const errorSpan = document.getElementById("qualifyMarkError");

            function calculateTotal() {
                const mq = parseInt(maxQ.value) || 0;
                const pm = parseInt(perMark.value) || 0;
                totalMarks.value = mq * pm;
                validateQualify();
            }

            function validateQualify() {
                const qualifyVal = parseInt(qualify.value) || 0;
                const totalVal = parseInt(totalMarks.value) || 0;

                if (qualifyVal > totalVal) {
                    errorSpan.textContent = "❌ Qualify mark cannot exceed total marks.";
                    return false;
                } else {
                    errorSpan.textContent = "";
                    return true;
                }
            }

            maxQ.addEventListener("input", calculateTotal);
            perMark.addEventListener("input", calculateTotal);
            qualify.addEventListener("input", validateQualify);

            form.addEventListener("submit", function (e) {
                if (!validateQualify()) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Validation Error',
                        text: 'Qualify mark cannot be greater than total marks.',
                        confirmButtonColor: '#d33'
                    });
                }
            });
        });
    </script>

    <!-- ✅ SweetAlert for TempData messages -->
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["SuccessMessage"]',
                        confirmButtonColor: '#3085d6'
                    });
                </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: '@TempData["ErrorMessage"]',
                        confirmButtonColor: '#d33'
                    });
                </text>
        }
    </script>
}
