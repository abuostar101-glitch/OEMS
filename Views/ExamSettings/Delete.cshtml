@model sampleapp.Models.ExamSettingViewModel

@{
    ViewData["Title"] = "Delete Exam Setting";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 600px;">
        <h4 class="text-center mb-4 text-danger">Delete Exam Setting</h4>

        <div class="alert alert-warning" role="alert">
            <strong>Warning:</strong> Are you sure you want to delete this exam setting?
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-5 fw-semibold">Subject</dt>
            <dd class="col-sm-7">@Model.SubjectName</dd>

            <dt class="col-sm-5 fw-semibold">Max Questions</dt>
            <dd class="col-sm-7">@Model.MaxQuestions</dd>

            <dt class="col-sm-5 fw-semibold">Marks Per Question</dt>
            <dd class="col-sm-7">@Model.MarkPerQuestion</dd>

            <dt class="col-sm-5 fw-semibold">Qualify Marks</dt>
            <dd class="col-sm-7">@Model.QualifyMark</dd>

            <dt class="col-sm-5 fw-semibold">Duration (mins)</dt>
            <dd class="col-sm-7">@Model.DurationMinutes</dd>

            <dt class="col-sm-5 fw-semibold">Total Marks</dt>
            <dd class="col-sm-7">@Model.TotalMarks</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger px-4">Delete</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: '@TempData["SuccessMessage"]'
                    });
                </text>
        }
    </script>
}
