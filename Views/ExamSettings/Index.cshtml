@model List<sampleapp.Models.ExamSettingViewModel>

@{
    ViewData["Title"] = "Exam Settings";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Exam Settings</h2>
        <a asp-action="Add" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Exam Setting
        </a>
    </div>

    <p class="text-muted">Total Exam Settings: @Model?.Count()</p>
@* 
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
 *@
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm rounded align-middle" id="ExamSettingDT">
                <thead class="table-dark">
                    <tr>
                        <th>Subject</th>
                        <th>Max Qs</th>
                        <th>Marks/Q</th>
                        <th>Qualify</th>
                        <th>Duration</th>
                        <th>Total</th>
                        <th class="text-end" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var setting in Model)
                    {
                        <tr>
                            <td>@setting.SubjectName</td>
                            <td>@setting.MaxQuestions</td>
                            <td>@setting.MarkPerQuestion</td>
                            <td>@setting.QualifyMark</td>
                            <td>@setting.DurationMinutes</td>
                            <td>@setting.TotalMarks</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@setting.Id" class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button class="btn btn-sm btn-danger" onclick="confirmDelete(@setting.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No exam settings found.</div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap 5 DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            $('#ExamSettingDT').DataTable({
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                paging: true,
                searching: true,
                ordering: true,
                responsive: true,
                columnDefs: [
                    { targets: 6, orderable: false }
                ]
            });
        });

        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete this exam setting.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/ExamSettings/Delete/' + id;
                }
            });
        }
    </script>
}

