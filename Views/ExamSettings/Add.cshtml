@model sampleapp.Models.ExamSettingViewModel

@{
    ViewData["Title"] = "Add Exam Setting";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="max-width: 900px; width: 100%;">
        <h4 class="text-center mb-4">Add Exam Setting</h4>

        <style>
            label.form-label {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                font-weight: 600;
                font-size: 1rem;
                color: #2c3e50;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                margin-bottom: 0.3rem;
                display: inline-block;
            }
        </style>

        <form asp-action="Add" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="SubjectId" class="form-label">Subject</label>
                        <select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select" title="Select subject for the exam">
                            <option value="">-- Select Subject --</option>
                        </select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxQuestions" class="form-label">Max Questions</label>
                        <input asp-for="MaxQuestions" class="form-control" type="number" placeholder="e.g. 20" id="@Html.IdFor(m => m.MaxQuestions)" />
                        <span asp-validation-for="MaxQuestions" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MarkPerQuestion" class="form-label">Marks Per Question</label>
                        <input asp-for="MarkPerQuestion" class="form-control" type="number" placeholder="e.g. 2" id="@Html.IdFor(m => m.MarkPerQuestion)" />
                        <span asp-validation-for="MarkPerQuestion" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="QualifyMark" class="form-label">Qualify Marks</label>
                        <input asp-for="QualifyMark" class="form-control" placeholder="e.g. 20" id="@Html.IdFor(m => m.QualifyMark)" />
                        <span asp-validation-for="QualifyMark" class="text-danger"></span>
                        <span id="qualifyMarkError" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DurationMinutes" class="form-label">Duration (Minutes)</label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" placeholder="e.g. 30" />
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TotalMarks" class="form-label">Total Marks</label>
                        <input asp-for="TotalMarks" class="form-control" type="number" readonly id="@Html.IdFor(m => m.TotalMarks)" />
                        <span asp-validation-for="TotalMarks" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary me-2">Add Exam Setting</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");

            const maxQuestionsInput = document.getElementById("@Html.IdFor(m => m.MaxQuestions)");
            const markPerQuestionInput = document.getElementById("@Html.IdFor(m => m.MarkPerQuestion)");
            const totalMarksInput = document.getElementById("@Html.IdFor(m => m.TotalMarks)");
            const qualifyInput = document.getElementById("@Html.IdFor(m => m.QualifyMark)");
            const errorSpan = document.getElementById("qualifyMarkError");

            function calculateTotalMarks() {
                const maxQ = parseInt(maxQuestionsInput.value) || 0;
                const perMark = parseInt(markPerQuestionInput.value) || 0;
                const total = maxQ * perMark;
                totalMarksInput.value = total;
                validateQualifyMark();
            }

            function validateQualifyMark() {
                const qualifyMark = parseInt(qualifyInput.value) || 0;
                const totalMarks = parseInt(totalMarksInput.value) || 0;

                if (qualifyMark > totalMarks) {
                    errorSpan.textContent = "❌ Qualify mark cannot exceed total marks.";
                    return false;
                } else {
                    errorSpan.textContent = "";
                    return true;
                }
            }

            maxQuestionsInput.addEventListener("input", calculateTotalMarks);
            markPerQuestionInput.addEventListener("input", calculateTotalMarks);
            qualifyInput.addEventListener("input", validateQualifyMark);

            form.addEventListener("submit", function (e) {
                const isValid = validateQualifyMark();
                if (!isValid) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Qualify Mark',
                        text: 'Qualify mark cannot be greater than total marks.',
                        confirmButtonColor: '#d33'
                    });
                }
            });
        });
    </script>

    <!-- SweetAlert on TempData -->
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: '@TempData["ErrorMessage"]',
                        confirmButtonColor: '#d33'
                    });
                </text>
        }

        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["SuccessMessage"]',
                        confirmButtonColor: '#3085d6'
                    });
                </text>
        }
    </script>
}
