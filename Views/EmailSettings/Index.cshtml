@model List<sampleapp.Models.EmailSettingsListItem>

@{
    ViewData["Title"] = "Email Settings List";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
    </div>

    <p class="text-muted">Total Email Settings: @Model?.Count()</p>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table id="emailSettingsTable" class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Server Name</th>
                        <th>Port Number</th>
                        <th>From Email</th>
                        <th class="text-end" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ServerName</td>
                            <td>@item.PortNumber</td>
                            <td>@item.FromEmailId</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No email settings found.</div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(function () {
            $('#emailSettingsTable').DataTable({
                paging: false,          // Pagination disabled
                searching: false,       // Searching disabled
                ordering: true,         // Column sorting enabled
                info: false,            // Info display disabled
                lengthChange: false,    // Entries-per-page dropdown disabled
                responsive: true
            });
        });
    </script>
}

