@model sampleapp.Models.EmailSettingsViewModel

@{
    ViewData["Title"] = "Edit Email Settings";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="max-width: 700px; width: 100%;">
        <h4 class="text-center mb-4">@ViewData["Title"]</h4>

        <style>
            label.form-label {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                font-weight: 600;
                font-size: 1rem;
                color: #2c3e50;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                margin-bottom: 0.3rem;
                display: inline-block;
            }
        </style>

        <form asp-action="Edit" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ProviderName" class="form-label">Provider Name</label>
                        <input asp-for="ProviderName" class="form-control" placeholder="e.g. Gmail, Outlook" />
                        <span asp-validation-for="ProviderName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ServerName" class="form-label">SMTP Server Name</label>
                        <input asp-for="ServerName" class="form-control" />
                        <span asp-validation-for="ServerName" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PortNumber" class="form-label">Port Number</label>
                        <input asp-for="PortNumber" type="number" class="form-control" />
                        <span asp-validation-for="PortNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FromEmailId" class="form-label">From Email ID</label>
                        <input asp-for="FromEmailId" type="email" class="form-control" />
                        <span asp-validation-for="FromEmailId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Update Email Settings</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
