@model List<sampleapp.Models.SubjectInfo>

@{
    ViewData["Title"] = "Subjects";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Subjects</h2>
        <a asp-controller="Subject" asp-action="AddSubject" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add New Subject
        </a>
    </div>

    <p class="text-muted">Total Subjects: @Model?.Count()</p>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table id="subjectDT" class="table table-bordered table-striped table-hover w-100">
                <thead class="table-dark">
                    <tr>
                        <th style="max-width: 300px;">Subject Name</th>
                        <th class="text-end" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in Model)
                    {
                        <tr>
                            <td style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @subject.SubjectName
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="SubEdit" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-primary me-1 px-2 py-1" title="Edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="DeleteSubject" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-danger px-2 py-1" title="Delete"
                                   onclick="return confirm('Are you sure you want to delete this subject?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No subjects found.</div>
    }
</div>

@section Scripts {
    <!-- ✅ Bootstrap 5 compatible DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- ✅ jQuery + Bootstrap 5 + DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $('#subjectDT').DataTable({
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                paging: true,
                searching: true,
                ordering: true,
                responsive: true,
                columnDefs: [
                    { targets: 1, orderable: false }
                ]
            });
        });
    </script>
}

