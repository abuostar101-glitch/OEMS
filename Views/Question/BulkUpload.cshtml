@model OEMS.Models.UploadExcel

@{
    ViewData["Title"] = "Upload Questions";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <span class="fs-5 fw-semibold">Upload Questions Excel</span>
                    <a href="~/uploads/questions.xlsx" class="btn btn-sm btn-light text-primary fw-semibold">
                        <i class="bi bi-download"></i> Download Format
                    </a>
                </div>

                <div class="card-body">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="ExcelFile" class="form-label fw-semibold">Select Excel File</label>
                            <input asp-for="ExcelFile" type="file" class="form-control" accept=".xlsx,.xls" />
                            <span asp-validation-for="ExcelFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-center mt-3">
                            <button type="submit" class="btn btn-primary px-5" id="uploadBtn">Upload</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            $('form').on('submit', function (e) {
                const fileInput = $('#ExcelFile').get(0);
                if (!fileInput || fileInput.files.length === 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'No File Selected',
                        text: 'Please select an Excel file before uploading.',
                        confirmButtonText: 'OK'
                    });
                    return false;
                }
                $('#uploadBtn').prop('disabled', true).text('Uploading...');
            });
        });
    </script>
}
