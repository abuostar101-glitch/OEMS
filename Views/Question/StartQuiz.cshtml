@model List<sampleapp.Models.QuestionViewModel>
@{
    ViewData["Title"] = "Start Quiz";
    var quizDuration = ViewBag.Duration ?? 10; // fallback to 10 minutes
}

<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <h4 class="text-center mb-4">Quiz</h4>

        <div class="d-flex justify-content-between mb-3">
            <span><strong>Time Remaining:</strong> <span id="timer"></span></span>
        </div>

        <!-- Progress bar -->
        <div class="progress mb-4">
            <div id="timeProgressBar" class="progress-bar bg-info" style="width: 100%;"></div>
        </div>

        <form id="quizForm" asp-action="SubmitQuiz" method="post">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="mb-4">
                    <p><strong>Q@(i + 1):</strong> @Model[i].QuestionText</p>

                    @foreach (var option in new[] { "A", "B", "C", "D" })
                    {
                        var optionText = Model[i].GetType().GetProperty("Option" + option)?.GetValue(Model[i])?.ToString();
                        if (!string.IsNullOrWhiteSpace(optionText))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       name="Answers[@i].SelectedAnswer"
                                       value="@option" required />
                                <label class="form-check-label">@option: @optionText</label>
                            </div>
                        }
                    }

                    <input type="hidden" name="Answers[@i].QuestionId" value="@Model[i].QuestionId" />
                </div>
            }

            <!-- Hidden field for quiz duration taken -->
            <input type="hidden" name="TimeTaken" id="TimeTaken" />

            <button type="submit" class="btn btn-success">Submit Quiz</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let minutes = @quizDuration;
        let seconds = 0;
        let totalSeconds = minutes * 60;
        let elapsedSeconds = 0;

        let timerDisplay = document.getElementById("timer");
        let progressBar = document.getElementById("timeProgressBar");

        const updateTimer = () => {
            timerDisplay.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        };

        updateTimer();

        let countdown = setInterval(() => {
            elapsedSeconds++;

            if (seconds === 0) {
                if (minutes === 0) {
                    clearInterval(countdown);
                    alert("Time is up! Submitting your quiz...");

                    // Disable all form inputs
                    document.querySelectorAll("input").forEach(input => input.disabled = true);

                    // Set time taken and submit
                    document.getElementById("TimeTaken").value = elapsedSeconds;
                    document.getElementById("quizForm").submit();
                    return;
                } else {
                    minutes--;
                    seconds = 59;
                }
            } else {
                seconds--;
            }

            updateTimer();

            // Update progress bar
            let remaining = totalSeconds - elapsedSeconds;
            let percent = (remaining / totalSeconds) * 100;
            progressBar.style.width = `${percent}%`;

        }, 1000);
    </script>
}
