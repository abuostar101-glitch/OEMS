@model List<sampleapp.Models.QuestionViewModel>
@using sampleapp.Models

@{
    ViewData["Title"] = "Question List";

    int? selectedSubjectId = ViewBag.SelectedSubjectId as int?;
    var subjects = ViewBag.Subjects as List<SubjectInfo> ?? new List<SubjectInfo>();
}

<style>
    .subject-select {
        height: 38px;
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
    }

        .subject-select option {
            font-size: 0.875rem;
        }

    /* 👇 Make table rows compact */
    #questionDT td,
    #questionDT th {
        padding: 6px 10px !important;
        font-size: 14px;
        vertical-align: middle;
    }

    /* 👇 Optional: truncate long questions with ellipsis */
    .truncate-text {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<div class="container mt-5">
    <h3 class="text-center mb-4">@ViewData["Title"]</h3>

    <!-- Filter Form -->
    <form method="get" asp-action="List" class="row g-3 mb-4">
        <div class="col-md-4">
            <label for="subjectId" class="form-label">Filter by Subject</label>
            <select name="subjectId" id="subjectId" class="form-select form-select-sm subject-select">
                <option value="">-- All Subjects --</option>
                @foreach (var subject in subjects)
                {
                    var selectedAttr = selectedSubjectId == subject.SubjectId ? "selected" : "";
                    var optionHtml = $"<option value='{subject.SubjectId}' {selectedAttr}>{subject.SubjectName}</option>";
                    @Html.Raw(optionHtml)
                }
            </select>
        </div>

        <div class="col-md-8 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">Search</button>
            <a asp-action="List" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table id="questionDT" class="table table-sm table-bordered table-striped table-hover w-100">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Subject</th>
                        <th>Question</th>
                        <th>Correct Answer</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var q in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@q.SubjectName</td>
                                <td class="truncate-text">@q.QuestionText</td> <!-- Truncated for clean layout -->
                                <td class="text-center fw-bold">@q.CorrectAnswer</td>
                                <td class="text-end d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@q.QuestionId" class="btn btn-sm btn-primary me-1">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@q.QuestionId" class="btn btn-sm btn-danger"
                                       onclick="return confirm('Are you sure you want to delete this question?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            No questions found.
        </div>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            $('#questionDT').DataTable({
                paging: true,
                pageLength: 10,
                searching: true,
                ordering: true,
                responsive: true
            });
        });
    </script>

