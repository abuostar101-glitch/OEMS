@model sampleapp.Models.RolesInfo

<h2 class="text-center mt-4">Add Role</h2>

<div class="container d-flex justify-content-center mt-3">
    <div class="card shadow p-4" style="width: 400px;">
        <h4 class="mb-4 text-center">New Role Details</h4>

        <form asp-action="AddRole" asp-controller="Role" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RoleName" class="form-label">Role Name</label>
                <input asp-for="RoleName" class="form-control" id="RoleName" placeholder="Enter role name"
                       oninput="this.value = this.value.toUpperCase();" autocomplete="off" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Add</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



