@model sampleapp.Models.RolesInfo

@{
    ViewData["Title"] = Model.RoleId == 0 ? "Add Role" : "Edit Role";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow p-4" style="width: 400px;">
        <h4 class="mb-4 text-center">@ViewData["Title"]</h4>

        <form asp-action="@(Model.RoleId == 0 ? "AddRole" : "EditRole")" asp-controller="Role" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="RoleId" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RoleName" class="form-label"></label>
                <input asp-for="RoleName"
                       class="form-control"
                       placeholder="Enter role name"
                       oninput="this.value = this.value.toUpperCase();"
                       required />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    @(Model.RoleId == 0 ? "Add" : "Save")
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
