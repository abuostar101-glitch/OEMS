@model OEMS.Models.StudentExamViewModel
@{
    ViewData["Title"] = "Schedule Exam";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 500px;">
        <h4 class="text-center mb-4">Delete Scheduled Exam</h4>

        <style>
            label.form-label {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                font-weight: 600;
                font-size: 1rem;
                color: #2c3e50;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                margin-bottom: 0.3rem;
                display: inline-block;
            }
        </style>

        <div class="alert alert-warning" role="alert">
            <strong>Warning:</strong> Are you sure you want to delete this scheduled exam?
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-5 fw-semibold">Student Reg. No</dt>
            <dd class="col-sm-7">@Model.RegistrationNumber</dd>

            <dt class="col-sm-5 fw-semibold">Subject</dt>
            <dd class="col-sm-7">@Model.SubjectName</dd>

            <dt class="col-sm-5 fw-semibold">Exam Date</dt>
            <dd class="col-sm-7">@((Model.ExamDate?.ToString("dd/MM/yyyy")) ?? "Not Scheduled")</dd>

            <dt class="col-sm-5 fw-semibold">Exam Time</dt>
            <dd class="col-sm-7">@Model.ExamTime</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StudentExamId" />
            <button type="submit" class="btn btn-danger px-4">Delete</button>
            <a asp-action="List" class="btn btn-secondary px-4">Cancel</a>
        </form>
    </div>
</div>
