@model List<OEMS.Models.StudentExamListDto>

@{
    ViewData["Title"] = "Scheduled Exams";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Schedule Exam
        </a>
    </div>

    <p class="text-muted">Total Scheduled Exams: <strong>@Model?.Count()</strong></p>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm rounded align-middle" id="ExamDT">
                <thead class="table-dark">
                    <tr>
                        <th>Reg No</th>
                        <th>Name</th>
                        <th>Subject</th>
                        <th>Exam Date</th>
                        <th>Exam Time</th>
                        <th class="text-end" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td>@exam.RegistrationNumber</td>
                            <td>@exam.StudentName</td>
                            <td>@exam.SubjectName</td>
                            <td>@(exam.ExamDate.HasValue? exam.ExamDate.Value.ToString("dd/MM/yyyy") : "")</td>
                            <td>@(exam.ExamTime.HasValue? exam.ExamTime.Value.ToString(@"hh\:mm") : "")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@exam.StudentExamId" class="btn btn-sm btn-warning me-1">
                                    <i class="bi bi-pencil-square"></i> Reschedule
                                </a>
                                <a asp-action="Delete" asp-route-id="@exam.StudentExamId" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            No exams scheduled yet.
        </div>
    }
</div>

@section Scripts {


    @if (TempData["InfoMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'info',
                title: 'No Changes',
                text: '@TempData["InfoMessage"]',
                confirmButtonText: 'OK'
            });
        </script>
    }
    <script>
        $(function () {
            $('#ExamDT').DataTable({
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                paging: true,
                searching: true,
                ordering: true,
                responsive: true
            });

            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('<form method="post" action="/StudentExam/Delete/' + id + '"></form>').appendTo('body').submit();
                    }
                });
            });

        });
    </script>
}

